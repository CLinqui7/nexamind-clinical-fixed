# Public frontend variables. These are safe to expose in Vite/Vercel.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Do NOT put WOMPI_CLIENT_SECRET or API Secret in VITE_ variables.
# Wompi secrets belong in Supabase Edge Function secrets.
