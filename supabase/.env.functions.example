# Wompi El Salvador - Supabase Edge Function secrets
# App ID from Wompi panel = WOMPI_CLIENT_ID
# API Secret from Wompi panel = WOMPI_CLIENT_SECRET
WOMPI_CLIENT_ID=PASTE_WOMPI_APP_ID
WOMPI_CLIENT_SECRET=PASTE_WOMPI_API_SECRET
WOMPI_AUTH_URL=https://id.wompi.sv/connect/token
WOMPI_API_URL=https://api.wompi.sv
WOMPI_AUDIENCE=wompi_api
APP_PUBLIC_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
WOMPI_NOTIFICATION_EMAIL=YOUR_EMAIL@example.com

# true for production. false only for a temporary demo without Supabase Auth.
WOMPI_REQUIRE_AUTH=true
