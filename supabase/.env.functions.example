# Wompi El Salvador credentials shown under API Rest in your Wompi app.
WOMPI_CLIENT_ID=PASTE_YOUR_APP_ID
WOMPI_CLIENT_SECRET=PASTE_YOUR_API_SECRET
WOMPI_AUTH_URL=https://id.wompi.sv/connect/token
WOMPI_API_URL=https://api.wompi.sv
WOMPI_AUDIENCE=wompi_api

# Your public Linkare/Vercel URL. This is also the URL to enter when Wompi asks for
# "URL relacionada al aplicativo".
APP_PUBLIC_URL=https://nexamind-clinical.vercel.app
WOMPI_NOTIFICATION_EMAIL=your-email@example.com

# Strong private key used only by Linkare's owner to change the plan price.
# Do not put this value in Vercel or GitHub.
LINKARE_ADMIN_KEY=GENERATE_A_LONG_RANDOM_SECRET
LINKARE_BILLING_ACCOUNT_SLUG=consultorio-demo

# Keep false for the local demo login. Change only after Supabase Auth is connected.
WOMPI_REQUIRE_AUTH=false
